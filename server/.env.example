# =========================================================================
# ON-FARM BACKEND CONFIGURATION (.env)
# =========================================================================

# Server Port
PORT=4000

# Super Admin Dashboard Secret Key (Aapka Admin Panel Login Password)
ADMIN_SECRET_KEY=onfarm_admin_master_2026

# -------------------------------------------------------------------------
# 1. SUPABASE DATABASE CONFIG (From Supabase -> Project Settings -> API)
# -------------------------------------------------------------------------
# URL: Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL

# Key: Use 'service_role' secret key (bypass RLS for server operations)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# -------------------------------------------------------------------------
# 2. CASHFREE PAYMENT GATEWAY CONFIG (From Cashfree -> Developers -> API Keys)
# -------------------------------------------------------------------------
# Mode: Set to 'PRODUCTION' for real payments, or 'TEST' for sandbox testing
CASHFREE_ENV=PRODUCTION

# Client ID (App ID)
CASHFREE_APP_ID=YOUR_CASHFREE_APP_ID

# Client Secret Key
CASHFREE_SECRET_KEY=YOUR_CASHFREE_SECRET_KEY

# -------------------------------------------------------------------------
# 3. ANTI-REVERSE ENGINEERING ENCRYPTION SECRET
# -------------------------------------------------------------------------
# 32-character secret key used to encrypt automation script sent to client RAM
SCRIPT_ENCRYPTION_SECRET=onfarm_super_secure_secret_key32
